# Application
APP_ENV=local

# Ports
SERVER_PORT=8080
FRONTEND_PORT=5173
DB_PORT=5432
DB_HOST_PORT=5433

# Database
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todolist
DB_SSL_MODE=disable

# JWT
JWT_SECRET=local-secret-key
JWT_EXPIRATION_HOURS=24

# Frontend Configuration
VITE_API_URL=/api

# Backend Configuration
GOPROXY=https://goproxy.cn,direct
DEBUG_MODE=true  # 启用调试模式
GIN_MODE=debug   # Gin框架的调试模式

# Logging
LOG_LEVEL=debug  # 可选值: debug, info, warn, error 